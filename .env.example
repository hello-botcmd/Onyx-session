# Required Telegram credentials (get these from https://my.telegram.org and @BotFather)
API_ID=123456
API_HASH=replace_with_your_telegram_api_hash
BOT_TOKEN=123456:replace_with_your_bot_token

# Optional bot settings
PLATFORM_NAME=VLR Session Manager
ADMIN_IDS=123456789
CHANNEL_LINK=@your_channel
SUPPORT_LINK=@your_support

# Connection / safety settings
MAX_CONCURRENCY=2
CONNECT_TIMEOUT=20
SKIP_SPAMBOT=false
GLOBAL_MAX_CONNECTIONS=25

# Optional general proxy (leave host blank to disable)
# PROXY_TYPE supports: socks5, socks4, http
PROXY_TYPE=none
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Optional Telegram device identity overrides
DEVICE_MODEL=
SYSTEM_VERSION=
APP_NAME=
APP_VERSION=

# Optional dedicated proxy used only after a Telegram FloodWait
FLOODWAIT_PROXY_HOST=
FLOODWAIT_PROXY_PORT=443
FLOODWAIT_PROXY_USER=
FLOODWAIT_PROXY_PASS=

# Enable only when the server has working public IPv6 connectivity
USE_IPV6=false
